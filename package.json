{
  "name": "formguard-js",
  "version": "1.0.0",
  "description": "A lightweight, developer-friendly JavaScript form validation library for browser and Node.js with schema support, password strength estimation, and zero dependencies.",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": {
      "require": "./src/index.js",
      "import": "./src/index.js",
      "browser": "./dist/formguard.min.js"
    }
  },
  "browser": "dist/formguard.min.js",
  "scripts": {
    "test": "node --test tests/",
    "build": "node build.js",
    "demo": "node -e \"const http=require('http'),fs=require('fs'),path=require('path');const s=http.createServer((req,res)=>{let f=path.join('./demo',req.url==='/'?'index.html':req.url);if(req.url.startsWith('/dist/')){f=path.join('.',req.url);}try{res.end(fs.readFileSync(f))}catch{res.statusCode=404;res.end('Not found')}});s.listen(3000,()=>console.log('Demo available at http://localhost:3000'))\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ganiya1617/formguard-js.git"
  },
  "bugs": {
    "url": "https://github.com/ganiya1617/formguard-js/issues"
  },
  "homepage": "https://github.com/ganiya1617/formguard-js#readme",
  "keywords": [
    "form-validation",
    "validation",
    "validator",
    "form",
    "email-validation",
    "password-validation",
    "phone-validation",
    "password-strength",
    "schema-validation",
    "formguard",
    "javascript",
    "browser",
    "nodejs",
    "zero-dependencies"
  ],
  "author": "Ganesh (ganiya1617) <sharmaganesh0291@gmail.com> (https://github.com/ganiya1617)",
  "license": "MIT",
  "files": [
    "src/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=14.0.0"
  }
}
